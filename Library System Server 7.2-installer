#!/bin/bash
set -e

# ── Defensive bash options ───────────────────────────────────────────────# nullglob: an empty /mnt/c/Users/*/ glob expands to nothing instead of "*"
shopt -s nullglob

GOLD="\033[0;33m"; GREEN="\033[0;32m"; CYAN="\033[0;36m"
RED="\033[0;31m"; YELLOW="\033[1;33m"; NC="\033[0m"

clear
echo -e "${GOLD}═══════════════════════════════════════════════════════════════${NC}"
echo -e "${GOLD}    ARK OF GRACE MINISTRIES - INSTALLER v7.2 (SAFE)${NC}"
echo -e "${GOLD}═══════════════════════════════════════════════════════════════${NC}"
echo ""

if [ "$EUID" -eq 0 ]; then
    echo -e "${RED} Please don't run as root!${NC}"
    exit 1
fi

if grep -qi microsoft /proc/version 2>/dev/null; then
    IS_WSL=true
    echo -e "${CYAN} WSL detected${NC}"
else
    IS_WSL=false
    echo -e "${CYAN} Native Linux detected${NC}"
fi
echo ""

if [ "$IS_WSL" = true ]; then
    echo -e "${CYAN} Windows users found:${NC}"
    echo ""

    USER_LIST=()
    for user_dir in /mnt/c/Users/*/; do
        user=$(basename "$user_dir")
        if [[ "$user" != "Public" && "$user" != "Default" && "$user" != "Default User" && "$user" != "All Users" ]]; then
            USER_LIST+=("$user")
            echo "   [$(( ${#USER_LIST[@]} ))] $user"
        fi
    done

    echo "   [0] Cancel"
    echo ""
    read -p "Enter number (1-${#USER_LIST[@]}, or 0 to cancel): " USER_CHOICE

    if [ "$USER_CHOICE" = "0" ]; then
        echo "Cancelled."
        exit 0
    fi
    if ! [[ "$USER_CHOICE" =~ ^[0-9]+$ ]] || [ "$USER_CHOICE" -lt 1 ] || [ "$USER_CHOICE" -gt "${#USER_LIST[@]}" ]; then
        echo -e "${RED} Invalid choice!${NC}"
        exit 1
    fi

    WIN_USER="${USER_LIST[$((USER_CHOICE-1))]}"
    INSTALL_DIR="/mnt/c/Users/$WIN_USER/Downloads/ark-library"
    echo -e "${GREEN} Selected: $WIN_USER${NC}"

    # FIX #1: printf with %s prints the path verbatim.
    # echo -e was eating \a in \ark-library as BEL.
    printf "${CYAN} Install location: %s${NC}\n" "C:\\Users\\$WIN_USER\\Downloads\\ark-library"
else
    INSTALL_DIR="$HOME/ark-library"
    WIN_USER=""
    echo -e "${CYAN} Install location: $INSTALL_DIR${NC}"
fi
echo ""

read -p "Continue? (y/n): " CONFIRM
if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
    echo "Cancelled."
    exit 0
fi

if [ -d "$INSTALL_DIR" ]; then
    EXISTING_VIDEOS=$(ls "$INSTALL_DIR/videos/" 2>/dev/null | wc -l)
    EXISTING_IMAGES=$(ls "$INSTALL_DIR/images/" 2>/dev/null | wc -l)
    EXISTING_AUDIO=$(ls "$INSTALL_DIR/audio/" 2>/dev/null | wc -l)
    if [ "$EXISTING_VIDEOS" -gt 0 ] || [ "$EXISTING_IMAGES" -gt 0 ] || [ "$EXISTING_AUDIO" -gt 0 ]; then
        echo -e "${YELLOW}  Found existing media files:${NC}"
        echo -e "    Videos: $EXISTING_VIDEOS"
        echo -e "    Images: $EXISTING_IMAGES"
        echo -e "    Audio:  $EXISTING_AUDIO"
        echo -e "${GREEN} These will be PRESERVED${NC}"
        echo ""
    fi
fi

echo -e "${CYAN} Ensuring folder structure exists...${NC}"
for folder in videos images audio; do
    if [ -d "$INSTALL_DIR/$folder" ]; then
        echo "    $folder/ (exists)"
    else
        mkdir -p "$INSTALL_DIR/$folder"
        echo "    $folder/ (created)"
    fi
done
echo ""

if [ ! -f "$INSTALL_DIR/generate-manifest.py" ]; then
    echo -e "${CYAN} Creating manifest generator...${NC}"
    cat > "$INSTALL_DIR/generate-manifest.py" << "PYEOF"
#!/usr/bin/env python3
import os, json
def scan_folder(folder, extensions):
    items = []
    if os.path.exists(folder):
        for f in sorted(os.listdir(folder)):
            if f.lower().endswith(extensions):
                items.append(f)
    return items
base = os.getcwd()
videos = scan_folder("videos", (".mp4", ".mov", ".webm", ".avi", ".mkv"))
images = scan_folder("images", (".png", ".jpg", ".jpeg", ".gif", ".webp"))
audio  = scan_folder("audio",  (".mp3", ".wav", ".ogg", ".m4a", ".flac"))
manifest = {"videos": videos, "images": images, "audio": audio}
with open("manifest.json", "w", encoding="utf-8") as f:
    json.dump(manifest, f, indent=2, ensure_ascii=False)
print(f" Videos: {len(videos)}, Images: {len(images)}, Audio: {len(audio)}")
PYEOF
    echo -e "${GREEN}    Created${NC}"
else
    echo -e "${CYAN} Manifest generator already exists - keeping it${NC}"
fi
echo ""

echo "$INSTALL_DIR" > ~/.ark_install_dir
if [ "$IS_WSL" = true ]; then echo "true" > ~/.ark_is_wsl; else echo "false" > ~/.ark_is_wsl; fi
echo -e "${CYAN}  Config files saved${NC}"
echo ""

mkdir -p ~/.local/bin

# ── Generate ark (server launcher) ──────────────────────────────────────
# FIX #2: single-quoted heredoc delimiter. Bash writes the body literally,
#         no expansion of \033, no execution of nested functions.
cat > ~/.local/bin/ark <<'ARK_EOF'
#!/bin/bash
ARK_DIR="$(cat ~/.ark_install_dir 2>/dev/null)"
IS_WSL="$(cat ~/.ark_is_wsl 2>/dev/null)"

C_RED='\033[0;31m'
C_GRN='\033[0;32m'
C_CYN='\033[0;36m'
NC='\033[0m'

if [ ! -d "$ARK_DIR" ]; then
    echo -e "${C_RED} ark-library not found at: $ARK_DIR${NC}"
    exit 1
fi

pkill -f "http.server 9000" 2>/dev/null
sleep 2

cd "$ARK_DIR"
nohup python3 -m http.server 9000 --bind 0.0.0.0 > /tmp/ark-library.log 2>&1 &
sleep 2

if command -v ss >/dev/null 2>&1; then
    ss -tuln 2>/dev/null | grep -q ":9000 " && UP=1 || UP=0
else
    pgrep -f "http.server 9000" >/dev/null && UP=1 || UP=0
fi

if [ "$UP" = "1" ]; then
    echo -e "${C_GRN} Server started!${NC}"
    echo -e "${C_CYN} http://localhost:9000${NC}"
    if [ "$IS_WSL" = "true" ]; then
        # FIX #3: clean single-arg PowerShell call (browser actually opens)
        powershell.exe -Command "Start-Process 'http://localhost:9000'" 2>/dev/null
    else
        xdg-open "http://localhost:9000" 2>/dev/null
    fi
else
    echo -e "${C_RED} Server failed. Check: /tmp/ark-library.log${NC}"
    cat /tmp/ark-library.log
fi
ARK_EOF
chmod +x ~/.local/bin/ark

# ── Generate ark-add (manifest refresher) ───────────────────────────────
cat > ~/.local/bin/ark-add <<'ARK_ADD_EOF'
#!/bin/bash
ARK_DIR="$(cat ~/.ark_install_dir 2>/dev/null)"

C_CYN='\033[0;36m'
C_RED='\033[0;31m'
C_GRN='\033[0;32m'
NC='\033[0m'

if [ ! -d "$ARK_DIR" ]; then
    echo -e "${C_RED} ark-library not found at: $ARK_DIR${NC}"
    exit 1
fi

cd "$ARK_DIR"
echo -e "${C_CYN} Updating manifest...${NC}"
python3 generate-manifest.py
echo -e "${C_GRN} Refresh browser!${NC}"
ARK_ADD_EOF
chmod +x ~/.local/bin/ark-add

# ── Generate ark-stop ───────────────────────────────────────────────────
cat > ~/.local/bin/ark-stop <<'STOP_EOF'
#!/bin/bash
pkill -f "http.server 9000" 2>/dev/null && echo " Stopped!" || echo "Not running"
STOP_EOF
chmod +x ~/.local/bin/ark-stop

echo -e "${GREEN} Commands installed: ark, ark-add, ark-stop${NC}"
echo ""

if ! grep -q ".local/bin" ~/.bashrc 2>/dev/null; then
    echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.bashrc
    echo -e "${CYAN}  Added ~/.local/bin to PATH permanently${NC}"
fi
export PATH="$HOME/.local/bin:$PATH"
echo ""

cd "$INSTALL_DIR"
echo -e "${CYAN} Generating manifest...${NC}"
python3 generate-manifest.py
echo ""

echo -e "${GOLD}═══════════════════════════════════════════════════════════════${NC}"
echo -e "${GOLD} INSTALLATION COMPLETE!${NC}"
echo -e "${GOLD}═══════════════════════════════════════════════════════════════${NC}"
echo ""
echo -e "${CYAN} Library: $INSTALL_DIR${NC}"
echo ""
echo -e "${CYAN} To start: ${YELLOW}ark${NC}"
echo -e "${CYAN} To update: ${YELLOW}ark-add${NC}"
echo -e "${CYAN} URL:       ${YELLOW}http://localhost:9000${NC}"
echo ""
echo -e "${GOLD} God bless your ministry! ${NC}"
echo -e "${GOLD}═══════════════════════════════════════════════════════════════${NC}"
